                <!-- ==========================================
         11. FREQUENTLY ASKED QUESTIONS (FAQ)
         ========================================== -->
                <section class="py-5 bg-white" id="faqSection">
                    <div class="container px-lg-5">
                        <div class="section-title-wrapper mb-5">
                            <h2 class="section-title">Frequently Asked Questions</h2>
                            <a href="#" class="section-link" id="linkViewAllFaq">View All FAQs <i class="fa-solid fa-arrow-right ms-1"></i></a>
                        </div>

                        <div class="row justify-content-center mt-2">
                            <div class="col-lg-10">
                                <div class="accordion" id="faqAccordion">
                                    <!-- FAQ 1 -->
                                    <div class="accordion-item" id="faqItem1">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="true" aria-controls="faqCollapse1" id="faqBtn1">
                                                How can I register for placement drives?
                                            </button>
                                        </h2>
                                        <div id="faqCollapse1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body">
                                                Eligible students can register directly through the Student Registration option on the homepage. Once registered, log in to your profile, complete your details, and apply for active drives listing in the portal.
                                            </div>
                                        </div>
                                    </div>
                                    <!-- FAQ 2 -->
                                    <div class="accordion-item" id="faqItem2">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2" id="faqBtn2">
                                                What is the eligibility criteria for placements?
                                            </button>
                                        </h2>
                                        <div id="faqCollapse2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body">
                                                The eligibility criteria vary depending on the recruiting company. Commonly, companies require a minimum CGPA (often 6.0 or above), no active backlogs, and specific branch/degree requirements (such as BCA, MCA, or B.Tech).
                                            </div>
                                        </div>
                                    </div>
                                    <!-- FAQ 3 -->
                                    <div class="accordion-item" id="faqItem3">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3" id="faqBtn3">
                                                How does the placement process work?
                                            </button>
                                        </h2>
                                        <div id="faqCollapse3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body">
                                                The placement process involves 6 key steps: 1) Portal Registration, 2) Profile Completion, 3) Eligibility Check by TPO, 4) Applying for specific drives, 5) Participating in written test/interviews, and 6) Final selection and offer letter distribution.
                                            </div>
                                        </div>
                                    </div>
                                    <!-- FAQ 4 -->
                                    <div class="accordion-item" id="faqItem4">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse4" aria-expanded="false" aria-controls="faqCollapse4" id="faqBtn4">
                                                What documents are required?
                                            </button>
                                        </h2>
                                        <div id="faqCollapse4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body">
                                                Generally, you will need updated resumes (hard and soft copies), passport-size photographs, college ID card, all marksheets (10th, 12th, and semesters), and Government ID proofs (Aadhar, PAN card, or Passport).
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

