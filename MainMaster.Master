                     7. SUCCESS STORIES & PLACEMENT PROCESS (REDESIGNED)
                     ========================================== -->
                <style>
                    /* Scoped Styles for Redesigned Section 7 */
                    #storiesProcessSection {
                        background-color: #ffffff;
                        padding-top: 3.5rem;
                        padding-bottom: 4rem;
                    }
                    .stories-eyebrow {
                        display: inline-flex;
                        align-items: center;
                        gap: 8px;
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-size: 0.82rem;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        text-transform: uppercase;
                        color: #0f2942;
                    }
                    .stories-eyebrow::before {
                        content: "";
                        display: inline-block;
                        width: 18px;
                        height: 3px;
                        background: #ef3724;
                        border-radius: 2px;
                    }
                    .stories-title {
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 800;
                        font-size: 2.25rem;
                        color: #0f2942;
                        line-height: 1.15;
                        margin-top: 0.35rem;
                        margin-bottom: 0.35rem;
                    }
                    .stories-subtitle {
                        font-family: var(--font-body, 'Inter', sans-serif);
                        font-size: 0.95rem;
                        color: #64748b;
                        margin-bottom: 0;
                    }
                    .stories-view-all {
                        display: inline-flex;
                        align-items: center;
                        gap: 6px;
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 700;
                        font-size: 0.95rem;
                        color: #ef3724;
                        text-decoration: none;
                        transition: gap 0.2s ease, color 0.2s ease;
                    }
                    .stories-view-all:hover {
                        color: #c92110;
                        gap: 10px;
                    }

                    /* Testimonial Carousel Wrapper */
                    .story-carousel-wrapper {
                        position: relative;
                        display: flex;
                        align-items: center;
                        width: 100%;
                    }
                    .story-nav-btn {
                        width: 42px;
                        height: 42px;
                        border-radius: 50%;
                        background: #ffffff;
                        border: 1px solid #e2e8f0;
                        color: #0f2942;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 0.9rem;
                        cursor: pointer;
                        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
                        transition: all 0.2s ease;
                        flex-shrink: 0;
                        z-index: 5;
                    }
                    .story-nav-btn:hover {
                        background: #ef3724;
                        border-color: #ef3724;
                        color: #ffffff;
                        transform: scale(1.06);
                    }
                    .story-nav-btn.prev-btn {
                        margin-right: -16px;
                    }

                    /* Carousel viewport & track */
                    .story-viewport {
                        width: 100%;
                        overflow: hidden;
                        border-radius: 20px;
                    }
                    .story-track {
                        display: flex;
                        transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
                        width: 100%;
                    }
                    .story-track > span,
                    .story-track > span > span {
                        display: contents;
                    }
                    .story-slide-item {
                        min-width: 100%;
                        max-width: 100%;
                        flex: 0 0 100%;
                        box-sizing: border-box;
                    }

                    /* Single Testimonial Card - Expanded & Sized Properly */
                    .story-card-box {
                        background: #ffffff;
                        border: 1.5px solid #edf2f7;
                        border-radius: 20px;
                        box-shadow: 0 10px 32px rgba(15, 41, 66, 0.06);
                        padding: 1.75rem 2rem;
                        display: flex;
                        align-items: center;
                        gap: 1.75rem;
                        min-height: 290px;
                        width: 100%;
                        box-sizing: border-box;
                    }
                    .story-photo-wrap {
                        position: relative;
                        width: 190px;
                        min-width: 190px;
                        height: 230px;
                        border-radius: 16px;
                        overflow: hidden;
                        background: #f1f5f9;
                        flex-shrink: 0;
                    }
                    .story-photo-wrap img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        object-position: top center;
                        display: block;
                    }
                    .story-badge-overlay {
                        position: absolute;
                        top: 10px;
                        right: 10px;
                        background: rgba(15, 41, 66, 0.92);
                        backdrop-filter: blur(4px);
                        color: #ffffff;
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 800;
                        font-size: 0.72rem;
                        padding: 3px 10px;
                        border-radius: 5px;
                        letter-spacing: 0.6px;
                        text-transform: uppercase;
                    }
                    .story-content-wrap {
                        flex: 1;
                        display: flex;
                        flex-direction: column;
                        justify-content: space-between;
                        min-height: 220px;
                    }
                    .story-quote-symbol {
                        color: #ef3724;
                        font-size: 1.85rem;
                        line-height: 1;
                        margin-bottom: 0.45rem;
                        opacity: 0.9;
                    }
                    .story-quote-text {
                        font-family: var(--font-body, 'Inter', sans-serif);
                        font-style: italic;
                        font-size: 0.95rem;
                        color: #334155;
                        line-height: 1.6;
                        margin-bottom: 1.25rem;
                    }
                    .story-meta-name {
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 800;
                        font-size: 1.15rem;
                        color: #0f2942;
                        margin: 0;
                        line-height: 1.2;
                    }
                    .story-meta-batch {
                        font-family: var(--font-body, 'Inter', sans-serif);
                        font-size: 0.84rem;
                        font-weight: 500;
                        color: #64748b;
                        margin: 0.15rem 0 0.6rem 0;
                    }
                    .story-recruiter-pill {
                        display: inline-flex;
                        align-items: center;
                        gap: 7px;
                        background: #f8fafc;
                        border: 1px solid #e2e8f0;
                        padding: 5px 12px;
                        border-radius: 7px;
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-size: 0.82rem;
                        font-weight: 700;
                        color: #0f2942;
                    }
                    .story-recruiter-pill i {
                        color: #ef3724;
                        font-size: 0.78rem;
                    }

                    /* Dots Navigation */
                    .story-dots-row {
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        gap: 6px;
                        margin-top: 1.25rem;
                    }
                    .story-dots-row .dot {
                        height: 7px;
                        border-radius: 50px;
                        background: #cbd5e1;
                        transition: all 0.3s ease;
                        cursor: pointer;
                    }

                    /* Collage Right Side - Scaled and Natural */
                    .stories-collage-container {
                        position: relative;
                        width: 100%;
                        display: flex;
                        align-items: center;
                        justify-content: flex-end;
                    }
                    .stories-collage-frame {
                        position: relative;
                        width: 100%;
                        max-width: 530px;
                        display: block;
                    }
                    .stories-collage-frame img {
                        width: 100%;
                        height: auto;
                        display: block;
                        object-fit: contain;
                    }

                    /* Divider between sections */
                    .process-section-divider {
                        border: none;
                        height: 1px;
                        background: #edf2f7;
                        margin: 3.75rem 0 3.25rem 0;
                    }

                    /* The Placement Process Sub-section */
                    .process-walkway-card {
                        position: relative;
                        border-radius: 18px;
                        overflow: hidden;
                        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
                        height: 100%;
                        min-height: 250px;
                        width: 100%;
                    }
                    .process-walkway-card img {
                        width: 100%;
                        height: 100%;
                        min-height: 250px;
                        object-fit: cover;
                        object-position: center;
                        display: block;
                    }

                    .process-header-title {
                        display: inline-flex;
                        align-items: center;
                        gap: 12px;
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 800;
                        font-size: 1.85rem;
                        color: #0f2942;
                        margin-bottom: 0.3rem;
                    }
                    .process-header-title::before {
                        content: "";
                        display: inline-block;
                        width: 4px;
                        height: 24px;
                        background: #ef3724;
                        border-radius: 2px;
                    }
                    .process-header-sub {
                        font-family: var(--font-body, 'Inter', sans-serif);
                        font-size: 0.92rem;
                        color: #64748b;
                        margin-bottom: 2.25rem;
                    }

                    /* 5-Step Stepper */
                    .process-stepper-track {
                        position: relative;
                        display: flex;
                        justify-content: space-between;
                        align-items: flex-start;
                        width: 100%;
                        padding: 0 0.5rem;
                    }
                    .process-stepper-track::before {
                        content: "";
                        position: absolute;
                        top: 24px;
                        left: 8%;
                        right: 8%;
                        height: 1px;
                        border-top: 2px dashed #fca5a5;
                        z-index: 1;
                    }
                    .process-step-node {
                        position: relative;
                        z-index: 2;
                        text-align: center;
                        flex: 1;
                        padding: 0 8px;
                    }
                    .process-circle-badge {
                        width: 48px;
                        height: 48px;
                        margin: 0 auto 0.75rem auto;
                        border-radius: 50%;
                        background: #ffffff;
                        border: 2px solid #ef3724;
                        box-shadow: 0 4px 12px rgba(239, 55, 36, 0.16);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 800;
                        font-size: 0.92rem;
                        color: #0f2942;
                        transition: all 0.25s ease;
                    }
                    .process-step-node:hover .process-circle-badge {
                        background: #ef3724;
                        color: #ffffff;
                        transform: translateY(-3px);
                        box-shadow: 0 6px 18px rgba(239, 55, 36, 0.28);
                    }
                    .process-node-title {
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 800;
                        font-size: 0.88rem;
                        color: #0f2942;
                        line-height: 1.25;
                        margin-bottom: 0.25rem;
                    }
                    .process-node-desc {
                        font-family: var(--font-body, 'Inter', sans-serif);
                        font-size: 0.76rem;
                        color: #64748b;
                        line-height: 1.35;
                        margin: 0;
                    }

                    @media (max-width: 991px) {
                        .story-card-box {
                            flex-direction: column;
                            gap: 1.25rem;
                            padding: 1.5rem;
                        }
                        .story-photo-wrap {
                            width: 100%;
                            height: 220px;
                        }
                        .stories-collage-container {
                            margin-top: 2rem;
                        }
                        .process-stepper-track {
                            flex-wrap: wrap;
                            gap: 1.5rem 0;
                        }
                        .process-stepper-track::before {
                            display: none;
                        }
                        .process-step-node {
                            flex: 0 0 50%;
                        }
                    }
                    #storiesProcessSection .stories-container-wrap {
                        width: 100%;
                        max-width: 1400px;
                        margin: 0 auto;
                        padding-left: 1.5rem;
                        padding-right: 1.5rem;
                    }
                    @media (min-width: 1200px) {
                        #storiesProcessSection .stories-container-wrap {
                            padding-left: 2rem;
                            padding-right: 2rem;
                        }
                    }
                </style>

                <section id="storiesProcessSection">
                    <div class="stories-container-wrap">

                        <!-- Upper Part: Success Stories -->
                        <div class="row align-items-center mb-4">
                            <div class="col-md-8">
                                <div class="stories-eyebrow">Real Stories</div>
                                <h2 class="stories-title">Success Stories</h2>
                                <p class="stories-subtitle mb-0">Hear from our students who turned their dreams into reality with support from RK University.</p>
                            </div>
                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                <a href="SuccessStories.aspx" class="stories-view-all" id="linkViewAllStories">
                                    View All Stories <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>

                        <div class="row g-4 align-items-center justify-content-between">
                            <!-- Left: Testimonial Card Slider -->
                            <div class="col-lg-6 col-md-12">
                                <div class="story-carousel-wrapper">
                                    <!-- Prev Arrow -->
                                    <button type="button" class="story-nav-btn prev-btn" onclick="prevStorySlide()" aria-label="Previous Story">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </button>

                                    <!-- Viewport -->
                                    <div class="story-viewport">
                                        <div class="story-track" id="indexSuccessStoriesRow">
                                            <asp:DataList ID="DataListSuccessStories" runat="server" RepeatLayout="Flow">
                                                <ItemTemplate>
                                                    <div class="story-slide-item">
                                                        <div class="story-card-box">
                                                            <div class="story-photo-wrap">
                                                                <img src='<%# ResolveUrl(Eval("StudentPhoto").ToString()) %>' alt='<%# Eval("StudentName") %>' onerror="this.src='assets/images/student_new_1.png';">
                                                                <span class="story-badge-overlay"><%# Eval("Recruiter") %></span>
                                                            </div>
                                                            <div class="story-content-wrap">
                                                                <div>
                                                                    <div class="story-quote-symbol"><i class="fa-solid fa-quote-left"></i></div>
                                                                    <p class="story-quote-text">"<%# Eval("Testimonial") %>"</p>
                                                                </div>
                                                                <div>
                                                                    <h5 class="story-meta-name"><%# Eval("StudentName") %></h5>
                                                                    <p class="story-meta-batch"><%# Eval("DegreeBranch") %></p>
                                                                    <div class="story-recruiter-pill">
                                                                        <i class="fa-solid fa-briefcase"></i>
                                                                        <span><%# Eval("Recruiter") %> &bull; <%# Eval("JobDesignation") %></span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </ItemTemplate>
                                            </asp:DataList>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dots -->
                                <div class="story-dots-row" id="indexStoryDots">
                                    <span class="dot" style="width: 18px; background-color: #ef3724;"></span>
                                    <span class="dot" style="width: 6px; background-color: #cbd5e1;"></span>
                                    <span class="dot" style="width: 6px; background-color: #cbd5e1;"></span>
                                </div>
                            </div>

                            <!-- Right: Campus Collage Graphic -->
                            <div class="col-lg-6 col-md-12">
                                <div class="stories-collage-container ps-lg-3">
                                    <div class="stories-collage-frame">
                                        <img src="assets/images/stories_campus_collage.png" alt="Real People Real Success - RK University Students">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Subtle Divider -->
                        <hr class="process-section-divider">

                        <!-- Lower Part: The Placement Process -->
                        <div class="row g-4 align-items-center" id="placementProcessTimeline">
                            <!-- Left: Campus Walkway Visual Card (Wider & Long) -->
                            <div class="col-lg-5 col-md-5">
                                <div class="process-walkway-card">
                                    <img src="assets/images/process_walkway.png" alt="Simple Steps, Big Opportunities - RK University Campus Walkway">
                                </div>
                            </div>

                            <!-- Right: Header & 5-Step Stepper -->
                            <div class="col-lg-7 col-md-7">
                                <div class="ps-lg-2">
                                    <h3 class="process-header-title">The Placement Process</h3>
                                    <p class="process-header-sub">From registration to your dream job &mdash; we make it simple.</p>

                                    <!-- 5-Step Stepper -->
                                    <div class="process-stepper-track">
                                        <!-- Step 1 -->
                                        <div class="process-step-node">
                                            <div class="process-circle-badge">01</div>
                                            <div class="process-node-title">Registration</div>
                                            <p class="process-node-desc">Create your profile</p>
                                        </div>

                                        <!-- Step 2 -->
                                        <div class="process-step-node">
                                            <div class="process-circle-badge">02</div>
                                            <div class="process-node-title">Resume Submission</div>
                                            <p class="process-node-desc">Get shortlisted</p>
                                        </div>

                                        <!-- Step 3 -->
                                        <div class="process-step-node">
                                            <div class="process-circle-badge">03</div>
                                            <div class="process-node-title">Apply for Drives</div>
                                            <p class="process-node-desc">Show your skills</p>
                                        </div>

                                        <!-- Step 4 -->
                                        <div class="process-step-node">
                                            <div class="process-circle-badge">04</div>
                                            <div class="process-node-title">Interviews</div>
                                            <p class="process-node-desc">(If Selected) Face the company</p>
                                        </div>

                                        <!-- Step 5 -->
                                        <div class="process-step-node">
                                            <div class="process-circle-badge">05</div>
                                            <div class="process-node-title">Offer &amp; Joining</div>
                                            <p class="process-node-desc">Start your career</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </section>


                <!-- ==========================================
                     10 & 11. FREQUENTLY ASKED QUESTIONS & NEED HELP SUPPORT
                     ========================================== -->
                <style>
                    /* Scoped Modern FAQ & Support Card Styling */
                    #faqSection {
                        background-color: #ffffff;
                        padding-top: 3.5rem;
                        padding-bottom: 4rem;
                    }
                    .faq-header-title {
                        display: inline-flex;
                        align-items: center;
                        gap: 12px;
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 800;
                        font-size: 2.15rem;
                        color: #111827;
                        line-height: 1.15;
                        margin-bottom: 0.35rem;
                    }
                    .faq-header-title::before {
                        content: "";
                        display: inline-block;
                        width: 4px;
                        height: 24px;
                        background: #ef3724;
                        border-radius: 2px;
                    }
                    .faq-header-sub {
                        font-family: var(--font-body, 'Inter', sans-serif);
                        font-size: 0.95rem;
                        color: #1f2937;
                        margin-bottom: 2rem;
                    }
                    .faq-view-all {
                        display: inline-flex;
                        align-items: center;
                        gap: 6px;
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 700;
                        font-size: 0.95rem;
                        color: #ef3724;
                        text-decoration: none;
                        transition: gap 0.2s ease, color 0.2s ease;
                    }
                    .faq-view-all:hover {
                        color: #c92110;
                        gap: 10px;
                    }

                    /* Rounded Pills Accordion Items */
                    .faq-pill-group {
                        display: flex;
                        flex-direction: column;
                        gap: 0.9rem;
                    }
                    .faq-pill-item {
                        border: 1px solid #f1f5f9 !important;
                        border-radius: 14px !important;
                        background-color: #f8fafc;
                        overflow: hidden;
                        transition: all 0.25s ease;
                    }
                    .faq-pill-item:hover {
                        background-color: #f1f5f9;
                        border-color: #e2e8f0 !important;
                    }
                    .faq-pill-btn {
                        width: 100%;
                        background: transparent !important;
                        border: none !important;
                        padding: 1.15rem 1.6rem !important;
                        display: flex !important;
                        align-items: center !important;
                        justify-content: space-between !important;
                        font-family: var(--font-heading, 'Outfit', sans-serif) !important;
                        font-weight: 700 !important;
                        font-size: 0.96rem !important;
                        color: #000000 !important;
                        text-align: left;
                        cursor: pointer;
                        box-shadow: none !important;
                        outline: none !important;
                    }
                    .faq-pill-btn::after {
                        display: none !important; /* override bootstrap default accordion chevron */
                    }
                    .faq-pill-btn .faq-icon {
                        font-size: 1rem;
                        color: #111827;
                        transition: transform 0.3s ease, color 0.2s ease;
                        margin-left: 1.25rem;
                        flex-shrink: 0;
                    }
                    /* When collapsed: plus icon stays plus */
                    .faq-pill-btn.collapsed .faq-icon {
                        transform: rotate(0deg);
                        color: #111827;
                    }
                    /* When expanded: plus icon rotates 45deg to become X */
                    .faq-pill-btn:not(.collapsed) .faq-icon {
                        transform: rotate(45deg);
                        color: #ef3724;
                    }
                    .faq-pill-btn:not(.collapsed) {
                        color: #000000 !important;
                    }
                    .faq-pill-body {
                        padding: 0 1.6rem 1.35rem 1.6rem;
                        font-family: var(--font-body, 'Inter', sans-serif);
                        font-size: 0.9rem;
                        color: #1f2937;
                        line-height: 1.65;
                    }

                    /* Need Help Support Card - Matches Reference Perfectly */
                    .faq-support-card {
                        background: #fbfcfe;
                        border: 1px solid #edf2f7;
                        border-radius: 20px;
                        overflow: hidden;
                        box-shadow: 0 8px 30px rgba(15, 41, 66, 0.05);
                        display: flex;
                        align-items: stretch;
                        width: 100%;
                        min-height: 275px;
                    }
                    .faq-support-img-wrap {
                        width: 48%;
                        min-width: 170px;
                        position: relative;
                        background: #f1f5f9;
                        overflow: hidden;
                    }
                    .faq-support-img-wrap img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        object-position: center top;
                        display: block;
                    }
                    .faq-support-content {
                        flex: 1;
                        padding: 2rem 2.25rem 2rem 1.85rem;
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                    }
                    .faq-support-title {
                        font-family: 'Playfair Display', Georgia, serif;
                        font-style: italic;
                        font-weight: 700;
                        font-size: 1.85rem;
                        color: #000000;
                        line-height: 1.15;
                        margin-bottom: 0.55rem;
                    }
                    .faq-support-desc {
                        font-family: var(--font-body, 'Inter', sans-serif);
                        font-size: 0.92rem;
                        color: #1f2937;
                        line-height: 1.5;
                        margin-bottom: 1.5rem;
                    }
                    .faq-support-btn {
                        display: inline-flex;
                        align-items: center;
                        gap: 8px;
                        background-color: #0c1a2e;
                        color: #ffffff !important;
                        font-family: var(--font-heading, 'Outfit', sans-serif);
                        font-weight: 700;
                        font-size: 0.88rem;
                        padding: 0.65rem 1.5rem;
                        border-radius: 50px;
                        text-decoration: none;
                        width: fit-content;
                        transition: all 0.25s ease;
                        box-shadow: 0 4px 14px rgba(12, 26, 46, 0.18);
                    }
                    .faq-support-btn:hover {
                        background-color: #ef3724;
                        transform: translateY(-2px);
                        box-shadow: 0 6px 18px rgba(239, 55, 36, 0.25);
                    }

                    @media (max-width: 991px) {
                        .faq-support-card {
                            margin-top: 1.5rem;
                            flex-direction: row;
                        }
                    }
                    @media (max-width: 576px) {
                        .faq-support-card {
                            flex-direction: column;
                        }
                        .faq-support-img-wrap {
                            width: 100%;
                            height: 220px;
                        }
                        .faq-support-content {
                            padding: 1.5rem;
                        }
                    }
                </style>

                <section id="faqSection">
                    <div class="container px-lg-5">

                        <!-- Header Row -->
                        <div class="row align-items-center mb-4">
                            <div class="col-md-8">
                                <h2 class="faq-header-title">Frequently Asked Questions</h2>
                                <p class="faq-header-sub mb-0">Find answers to the most common queries about placements at RK University.</p>
                            </div>
                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                <a href="Contact.aspx" class="faq-view-all" id="linkViewAllFaq">
                                    View All FAQs <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>

                        <!-- 2-Column Split: FAQs Left & Need Help Right -->
                        <div class="row g-4 align-items-center">

                            <!-- Left: Accordion Pills (Col 7) -->
                            <div class="col-lg-7">
                                <div class="faq-pill-group" id="faqAccordion">

                                    <!-- FAQ 1 -->
                                    <div class="faq-pill-item" id="faqItem1">
                                        <button class="faq-pill-btn collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="false" aria-controls="faqCollapse1" id="faqBtn1">
                                            <span>How can I register for placement drives?</span>
                                            <i class="fa-solid fa-plus faq-icon"></i>
                                        </button>
                                        <div id="faqCollapse1" class="collapse" data-bs-parent="#faqAccordion">
                                            <div class="faq-pill-body">
                                                Eligible students can register directly through the Student Registration option on the homepage. Once registered, log in to your profile, complete your details, and apply for active drives listing in the portal.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- FAQ 2 -->
                                    <div class="faq-pill-item" id="faqItem2">
                                        <button class="faq-pill-btn collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2" id="faqBtn2">
                                            <span>What is the eligibility criteria for placements?</span>
                                            <i class="fa-solid fa-plus faq-icon"></i>
                                        </button>
                                        <div id="faqCollapse2" class="collapse" data-bs-parent="#faqAccordion">
                                            <div class="faq-pill-body">
                                                The eligibility criteria vary depending on the recruiting company. Commonly, companies require a minimum CGPA (often 6.0 or above), no active backlogs, and specific branch/degree requirements (such as BCA, MCA, or B.Tech).
                                            </div>
                                        </div>
                                    </div>

                                    <!-- FAQ 3 -->
                                    <div class="faq-pill-item" id="faqItem3">
                                        <button class="faq-pill-btn collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3" id="faqBtn3">
                                            <span>How does the placement process work?</span>
                                            <i class="fa-solid fa-plus faq-icon"></i>
                                        </button>
                                        <div id="faqCollapse3" class="collapse" data-bs-parent="#faqAccordion">
                                            <div class="faq-pill-body">
                                                The placement process involves 5 key steps: 1) Portal Registration, 2) Resume Submission &amp; Profile Completion, 3) Eligibility Check by TPO, 4) Applying for drives, and 5) Interviews &amp; Final Offer Selection.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- FAQ 4 -->
                                    <div class="faq-pill-item" id="faqItem4">
                                        <button class="faq-pill-btn collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse4" aria-expanded="false" aria-controls="faqCollapse4" id="faqBtn4">
                                            <span>What documents are required?</span>
                                            <i class="fa-solid fa-plus faq-icon"></i>
                                        </button>
                                        <div id="faqCollapse4" class="collapse" data-bs-parent="#faqAccordion">
                                            <div class="faq-pill-body">
                                                Generally, you will need updated resumes (hard and soft copies), passport-size photographs, college ID card, all marksheets (10th, 12th, and semesters), and Government ID proofs (Aadhar, PAN card, or Passport).
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- Right: Need Help? Card (Col 5) -->
                            <div class="col-lg-5">
                                <div class="faq-support-card">
                                    <div class="faq-support-img-wrap">
                                        <img src="assets/images/faq_need_help_student.png" alt="RK University Student Support">
                                    </div>
                                    <div class="faq-support-content">
                                        <h3 class="faq-support-title">Need Help?</h3>
                                        <p class="faq-support-desc">Our placement team is here to assist you with any queries.</p>
                                        <a href="Contact.aspx" class="faq-support-btn" id="btnFaqContactUs">
                                            Contact Us <i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </section>

            </asp:ContentPlaceHolder>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
                <footer class="footer pt-5" id="siteFooter">
                    <div class="container px-lg-5">
