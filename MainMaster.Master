            <!-- Action Buttons Row -->
            <div class="d-flex align-items-center gap-2 justify-content-end">
                <!-- Back To Top Button -->
                <button type="button" id="btnBackToTop" class="btn btn-dark rounded-circle shadow" style="width: 44px; height: 44px; display: none; align-items: center; justify-content: center; transition: all 0.3s ease;" onclick="window.scrollTo({top: 0, behavior: 'smooth'});" title="Back to top">
                    <i class="fa-solid fa-arrow-up" style="font-size: 0.95rem;"></i>
                </button>

                <!-- Floating TPO Helpdesk Trigger Button -->
                <button type="button" class="btn btn-rku rounded-pill shadow-lg px-3.5 py-2.5 d-flex align-items-center gap-2 fw-semibold" onclick="toggleQuickHelp()" style="font-size: 0.88rem; box-shadow: 0 8px 24px rgba(224, 54, 39, 0.35);">
                    <i class="fa-solid fa-comment-dots fs-5"></i> <span>TPO Help</span>
                </button>
            </div>
        </div>

        <script>
            function toggleQuickHelp() {
                const menu = document.getElementById('rkuQuickMenu');
                if (menu) {
                    menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
                }
            }

            // Show/Hide Back to Top Button
            window.addEventListener('scroll', () => {
                const topBtn = document.getElementById('btnBackToTop');
                if (topBtn) {
                    if (window.scrollY > 300) {
                        topBtn.style.display = 'inline-flex';
                    } else {
                        topBtn.style.display = 'none';
                    }
                }
            });
        </script>
    </form>
</body>
</html>
