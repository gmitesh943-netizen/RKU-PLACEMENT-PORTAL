                    <button type="button" class="btn-close" style="font-size: 0.7rem;" onclick="toggleQuickHelp()"></button>
                </div>
                <div class="d-flex flex-column gap-2" style="font-size: 0.84rem;">
                    <a href="tel:+919876543210" class="d-flex align-items-center gap-2.5 p-2 rounded-2 text-decoration-none text-dark bg-light hover-shadow">
                        <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.75rem;"><i class="fa-solid fa-phone"></i></div>
                        <div>
                            <div class="fw-bold">Call Placement Cell</div>
                            <small class="text-muted">+91 98765 43210</small>
                        </div>
                    </a>
                    <a href="mailto:placement@rku.ac.in" class="d-flex align-items-center gap-2.5 p-2 rounded-2 text-decoration-none text-dark bg-light hover-shadow">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.75rem;"><i class="fa-solid fa-envelope"></i></div>
                        <div>
                            <div class="fw-bold">Email Inquiries</div>
                            <small class="text-muted">placement@rku.ac.in</small>
                        </div>
                    </a>
                    <a href="PlacementPolicy.aspx" class="d-flex align-items-center gap-2.5 p-2 rounded-2 text-decoration-none text-dark bg-light hover-shadow">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.75rem;"><i class="fa-solid fa-gavel"></i></div>
                        <div>
                            <div class="fw-bold">Placement Policy</div>
