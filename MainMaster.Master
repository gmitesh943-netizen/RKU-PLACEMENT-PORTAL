                <!-- Database -->
                <script src="js/portal-db.js"></script>

                <!-- Chart.js Library -->
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

                <!-- Bootstrap 5 Bundle JS -->
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

                <!-- Custom JS -->
                <script src="js/main.js"></script>

                <!-- Dynamic Data Loading -->
                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        renderDynamicIndexData();
                    });

                    function renderDynamicIndexData() {
                        const companies = (window.PortalDB && typeof PortalDB.getCompanies === 'function') ? PortalDB.getCompanies() : [];

                        // Setup Success Stories carousel using database-rendered slides
                        const storiesRow = document.getElementById('indexSuccessStoriesRow');
                        const storyDots = document.getElementById('indexStoryDots');
                        if (storiesRow) {
                            let slides = Array.from(storiesRow.querySelectorAll('.story-slide-item'));

                            // Fallback if accessed via static server without ASP.NET server rendering
                            if (slides.length === 0 && window.PortalDB && typeof PortalDB.getStories === 'function') {
                                const dbStories = PortalDB.getStories();
                                if (dbStories && dbStories.length > 0) {
                                    storiesRow.innerHTML = dbStories.map(s => {
                                        const photoSrc = s.studentPhoto || 'assets/images/student_new_1.png';
                                        const quoteText = s.quote || 'RK University gave me the right platform, skills and support to crack interviews at top companies. Grateful to the placement cell!';
                                        const companyBadge = s.recruiterName || 'RKU';
                                        const roleTitle = s.role || 'Placed Student';
                                        const degreeText = s.degreeBranch ? (s.degreeBranch.includes('|') ? s.degreeBranch : s.degreeBranch + ' | 2024 Batch') : '2024 Batch';

                                        return `
                                            <div class="story-slide-item">
                                                <div class="story-card-box">
                                                    <div class="story-photo-wrap">
                                                        <img src="${photoSrc}" alt="${s.studentName}" onerror="this.src='assets/images/student_new_1.png';">
                                                        <span class="story-badge-overlay">${companyBadge}</span>
                                                    </div>
                                                    <div class="story-content-wrap">
                                                        <div>
                                                            <div class="story-quote-symbol"><i class="fa-solid fa-quote-left"></i></div>
                                                            <p class="story-quote-text">"${quoteText}"</p>
                                                        </div>
                                                        <div>
                                                            <h5 class="story-meta-name">${s.studentName}</h5>
                                                            <p class="story-meta-batch">${degreeText}</p>
                                                            <div class="story-recruiter-pill">
                                                                <i class="fa-solid fa-briefcase"></i>
                                                                <span>${companyBadge} &bull; ${roleTitle}</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        `;
                                    }).join('');
                                    slides = Array.from(storiesRow.querySelectorAll('.story-slide-item'));
                                }
                            }

                            const totalSlides = slides.length;
                            let currentSlide = 0;

                            if (storyDots) {
                                storyDots.innerHTML = slides.map((_, i) => `
                                    <span class="dot" onclick="window.goToStorySlide(${i})" style="width: ${i === 0 ? '18px' : '6px'}; background-color: ${i === 0 ? '#ef3724' : '#cbd5e1'};"></span>
                                `).join('');
                            }

                            function setActiveDot(index) {
                                if (!storyDots) return;
                                Array.from(storyDots.children).forEach((dot, i) => {
                                    dot.style.width = i === index ? '18px' : '6px';
                                    dot.style.backgroundColor = i === index ? '#ef3724' : '#cbd5e1';
                                });
                            }

                            function goToSlide(index) {
                                if (totalSlides <= 0) return;
                                currentSlide = (index + totalSlides) % totalSlides;
                                storiesRow.style.transform = `translateX(-${currentSlide * 100}%)`;
                                setActiveDot(currentSlide);
                            }

                            window.goToStorySlide = goToSlide;
                            window.prevStorySlide = function() {
                                goToSlide(currentSlide - 1);
                                resetStoriesTimer();
                            };
                            window.nextStorySlide = function() {
                                goToSlide(currentSlide + 1);
                                resetStoriesTimer();
                            };

                            function resetStoriesTimer() {
                                if (window.__homeStoriesTimer) {
                                    clearInterval(window.__homeStoriesTimer);
                                }
                                if (totalSlides > 1) {
                                    window.__homeStoriesTimer = setInterval(() => {
                                        goToSlide(currentSlide + 1);
                                    }, 4500);
                                }
                            }

                            goToSlide(0);
                            resetStoriesTimer();
                        }

                        // Render Top Recruiters Marquee
                        const recruitersTrack = document.getElementById('indexRecruitersTrack');
                        if (recruitersTrack && companies.length > 0) {
                            let trackHtml = '';
                            const marqueeCompanies = companies.slice(0, 10); // Show up to 10 companies

                            // Helper function to create items matching the clean borderless layout
                            const createMarqueeItems = () => {
                                return marqueeCompanies.map(c => `
                        <div class="recruiter-logo-clean-item">
                            ${c.logoBase64
                                        ? `<img src="${c.logoBase64}" alt="${c.name}">`
                                        : `<span style="font-family: var(--font-heading, 'Outfit'); font-weight: 700; font-size: 1.15rem; color: #0f2942; text-align: center;">${c.name}</span>`
                                    }
                        </div>
                    `).join('');
                            };

                            // Add items twice for seamless infinite loop effect
                            trackHtml = createMarqueeItems() + createMarqueeItems();
                            recruitersTrack.innerHTML = trackHtml;
                        }
                    }
                </script>

                <!-- Hero Background Image Slideshow -->
                <script>
                    (function () {
                        const slides = document.querySelectorAll('.hero-bg-slide');
                        const dots = document.querySelectorAll('.hero-dot');
                        let current = 0;
                        const total = slides.length;

                        function goTo(index) {
                            slides[current].classList.remove('active');
                            dots[current].classList.remove('active');
                            current = (index + total) % total;
                            slides[current].classList.add('active');
                            dots[current].classList.add('active');
                        }

                        // Auto-advance every 3 seconds
                        let timer = setInterval(() => goTo(current + 1), 3000);

                        // Click on dots to jump to slide
                        dots.forEach((dot, i) => {
                            dot.addEventListener('click', () => {
                                clearInterval(timer);
                                goTo(i);
                                timer = setInterval(() => goTo(current + 1), 3000);
                            });
                        });
                    })();
                </script>
                <!-- Code injected by live-server -->
                <script>
                    // <![CDATA[  <-- For SVG support
                    if ('WebSocket' in window) {
                        (function () {
                            function refreshCSS() {
                                var sheets = [].slice.call(document.getElementsByTagName("link"));
                                var head = document.getElementsByTagName("head")[0];
                                for (var i = 0; i < sheets.length; ++i) {
                                    var elem = sheets[i];
                                    var parent = elem.parentElement || head;
                                    parent.removeChild(elem);
                                    var rel = elem.rel;
                                    if (elem.href && typeof rel != "string" || rel.length == 0 || rel.toLowerCase() == "stylesheet") {
                                        var url = elem.href.replace(/(&|\?)_cacheOverride=\d+/, '');
                                        elem.href = url + (url.indexOf('?') >= 0 ? '&' : '?') + '_cacheOverride=' + (new Date().valueOf());
                                    }
                                    parent.appendChild(elem);
                                }
                            }
                            var protocol = window.location.protocol === 'http:' ? 'ws://' : 'wss://';
                            var address = protocol + window.location.host + window.location.pathname + '/ws';
                            var socket = new WebSocket(address);
                            socket.onmessage = function (msg) {
                                if (msg.data == 'reload') window.location.reload();
                                else if (msg.data == 'refreshcss') refreshCSS();
                            };
                            if (sessionStorage && !sessionStorage.getItem('IsThisFirstTime_Log_From_LiveServer')) {
                                console.log('Live reload enabled.');
                                sessionStorage.setItem('IsThisFirstTime_Log_From_LiveServer', true);
                            }
                        })();
                    }
                    else {
                        console.error('Upgrade your browser. This Browser is NOT supported WebSocket for Live-Reloading.');
                    }
                    // ]]>
                </script>
</body>
</html>



</asp:ContentPlaceHolder>
