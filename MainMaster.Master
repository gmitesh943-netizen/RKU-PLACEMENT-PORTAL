<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MainMaster.master.cs" Inherits="RKU_PLACEMENT_PORTAL.MainMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="css/style.css?v=2" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600&display=swap" rel="stylesheet">

    <!-- Open Graph & Social Sharing SEO -->
    <meta property="og:site_name" content="RK University Placement Portal">
    <meta property="og:title" content="RK University Placement Portal | Connecting Talent with Opportunities">
    <meta property="og:description" content="Official Training and Placement Portal of RK University, Rajkot. Explore campus placement drives, recruiters, success stories, and career development opportunities.">
    <meta property="og:type" content="website">
    <meta property="og:image" content="assets/images/RKU%20LOGO.png">
    <meta name="twitter:card" content="summary_large_image">

    <!-- Google Schema.org Structured Data (EducationalOrganization) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "RK University Training and Placement Cell",
      "url": "https://rku.ac.in",
      "logo": "https://rku.ac.in/assets/images/RKU%20LOGO.png",
      "description": "Connecting talent with top corporate opportunities across Engineering, IT, Management, and Pharmacy disciplines.",
      "sameAs": [
        "https://www.facebook.com/rkuindia",
        "https://www.linkedin.com/school/rk-university",
        "https://www.instagram.com/rkuniversity",
        "https://www.youtube.com/rkuniversity"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bhavnagar Highway, Kasturbadham",
        "addressLocality": "Rajkot",
        "addressRegion": "Gujarat",
        "postalCode": "360020",
        "addressCountry": "IN"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-9876543210",
        "contactType": "Placement Office",
        "email": "placement@rku.ac.in"
      }
    }
    </script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">

                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>Placement Portal | RK University</title>

                    <!-- Meta Tags for SEO -->
                    <meta name="description" content="RK University Placement Portal - Connecting talent with opportunities. Empowering students with industry-ready careers, internships, and campus placements.">
                    <meta name="keywords" content="RK University, Placement Portal, University Placements, Rajkot College, Gujarat Placements, Job Portal, Student Internships, Top Recruiters">
                    <meta name="author" content="RK University">

                    <!-- Bootstrap 5 CSS -->
                    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

                    <!-- FontAwesome Icons -->
                    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">

                    <!-- Custom CSS -->
                    <link href="css/style.css" rel="stylesheet">

                    <style>
                        .home-stories-scroll {
                            overflow: hidden;
                        }

                        .home-stories-track {
                            display: flex;
                            flex-wrap: nowrap;
                            transition: transform 0.65s ease;
                            will-change: transform;
                        }

                        .home-story-slide {
                            flex: 0 0 100%;
                            width: 100%;
                            padding-right: 0;
                        }

                        .home-story-card {
                            background: #fff;
                            border-radius: 18px;
                            box-shadow: 0 8px 26px rgba(0, 0, 0, 0.04);
                            height: 100%;
                            padding: 1rem;
                            border: 1px solid #eef0f3;
                            max-width: 420px;
                            margin: 0 auto;
                        }

                        .home-story-img,
                        .home-story-placeholder {
                            width: 100%;
                            height: 260px;
                            object-fit: cover;
                            object-position: top center;
                            border-radius: 14px;
                            margin-bottom: 1rem;
                            display: block;
                        }

                        .home-story-placeholder {
                            background: #f1f3f5;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            color: #94a3b8;
                        }

                        .home-story-name {
                            font-family: var(--font-heading);
                            font-weight: 800;
                            font-size: 1.05rem;
                            color: var(--rku-dark);
                            margin: 0 0 0.25rem 0;
                        }

                        .home-story-course {
                            font-size: 0.84rem;
                            font-weight: 600;
                            color: #6b7280;
                            margin: 0;
                        }

                        .home-story-company {
                            font-family: var(--font-heading);
                            font-weight: 800;
                            font-size: 0.95rem;
                            color: var(--rku-maroon);
                            margin: 0.5rem 0 0.2rem 0;
                        }

                        .home-story-package {
                            font-family: var(--font-heading);
                            font-weight: 800;
                            font-size: 1.1rem;
                            color: var(--rku-dark);
                            margin: 0.15rem 0 0;
                        }

                        @media (max-width: 767.98px) {
                            .home-story-card {
                                max-width: 100%;
                            }

                            .home-story-img,
                            .home-story-placeholder {
                                height: 210px;
                            }
                        }
                    </style>
                </head>
                <body>

                    <!-- ==========================================
                         1. HEADER TOPBAR & NAVBAR
                         ========================================== -->
                    <!-- RKU Header Topbar -->
                    <div class="rku-header-topbar d-none d-lg-block" style="background:#ffffff; border-bottom:1px solid #edf2f7; font-size:0.84rem; color:#334155; position:relative; z-index:1031;">
                        <div class="container-fluid px-lg-5">
                            <div class="d-flex justify-content-between align-items-center py-2">
                                <!-- Left: Tagline with Graduation Cap -->
                                <div class="topbar-tagline d-flex align-items-center" style="font-weight:500; color:#334155;">
                                    <i class="fa-solid fa-graduation-cap topbar-icon me-2" style="color:#e03627; font-size:0.95rem;"></i>
                                    <span>Empowering Students. Connecting Companies. Building Careers.</span>
                                </div>
                                <!-- Right: Contact info & Social Media Icons -->
                                <div class="topbar-contact d-flex align-items-center gap-3">
                                    <a href="tel:+919876543210" class="topbar-link" style="color:#334155; text-decoration:none; display:inline-flex; align-items:center;">
                                        <i class="fa-solid fa-phone topbar-icon me-1.5" style="color:#e03627; font-size:0.85rem;"></i> <span style="color:#334155;">+91 98765 43210</span>
                                    </a>
                                    <span class="topbar-divider" style="color:#cbd5e1;">|</span>
                                    <a href="mailto:placement@rku.ac.in" class="topbar-link" style="color:#334155; text-decoration:none; display:inline-flex; align-items:center;">
                                        <i class="fa-solid fa-envelope topbar-icon me-1.5" style="color:#e03627; font-size:0.85rem;"></i> <span style="color:#334155;">placement@rku.ac.in</span>
                                    </a>
                                    <div class="topbar-socials d-flex align-items-center gap-1.5 ms-2">
                                        <a href="https://facebook.com" target="_blank" class="social-circle-btn" title="Facebook" style="width:26px; height:26px; min-width:26px; border-radius:50%; background:linear-gradient(135deg, #e03627, #c5281b); color:#ffffff !important; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; box-shadow:0 2px 6px rgba(224,54,39,0.25);"><i class="fa-brands fa-facebook-f" style="color:#ffffff !important; font-size:0.72rem;"></i></a>
                                        <a href="https://linkedin.com" target="_blank" class="social-circle-btn" title="LinkedIn" style="width:26px; height:26px; min-width:26px; border-radius:50%; background:linear-gradient(135deg, #e03627, #c5281b); color:#ffffff !important; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; box-shadow:0 2px 6px rgba(224,54,39,0.25);"><i class="fa-brands fa-linkedin-in" style="color:#ffffff !important; font-size:0.72rem;"></i></a>
                                        <a href="https://instagram.com" target="_blank" class="social-circle-btn" title="Instagram" style="width:26px; height:26px; min-width:26px; border-radius:50%; background:linear-gradient(135deg, #e03627, #c5281b); color:#ffffff !important; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; box-shadow:0 2px 6px rgba(224,54,39,0.25);"><i class="fa-brands fa-instagram" style="color:#ffffff !important; font-size:0.72rem;"></i></a>
                                        <a href="https://youtube.com" target="_blank" class="social-circle-btn" title="YouTube" style="width:26px; height:26px; min-width:26px; border-radius:50%; background:linear-gradient(135deg, #e03627, #c5281b); color:#ffffff !important; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; box-shadow:0 2px 6px rgba(224,54,39,0.25);"><i class="fa-brands fa-youtube" style="color:#ffffff !important; font-size:0.72rem;"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <nav class="navbar navbar-expand-lg sticky-top">
                        <div class="container-fluid px-lg-5">
                            <!-- Brand Logo -->
                            <a class="navbar-brand d-flex align-items-center" href="#" id="navbarBrandLink">
                                <img src="assets/images/RKU LOGO.png" alt="RK University Placement Portal" class="me-2" style="height: 48px; width: auto; max-width: 240px; object-fit: contain;">
                            </a>

                            <!-- Mobile Toggle -->
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation" id="navbarToggleButton">
                                <span class="navbar-toggler-icon"></span>
                            </button>

                            <!-- Navigation Links -->
                            <div class="collapse navbar-collapse" id="mainNavbar">
                                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                                    <li class="nav-item">
                                        <a class="nav-link active" aria-current="page" href="Index.aspx" id="navHome">Home</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="About.aspx" id="navAbout">About Us</a>
                                    </li>

                                    <li class="nav-item dropdown" id="navItemPlacement">
                                        <a class="nav-link nav-placement-btn dropdown-toggle" href="#" id="navDrives" data-bs-toggle="dropdown" aria-expanded="false">Placement <i class="fa-solid fa-chevron-down placement-caret"></i>
                                        </a>
                                        <ul class="dropdown-menu nav-placement-dropdown" aria-labelledby="navDrives">
                                <li><a class="dropdown-item" href="PlacementAbout.aspx" id="navPlacementAbout">About Us</a></li>
                                            <li><a class="dropdown-item" href="PlacementCampusDrives.aspx" id="navPlacementCampus">Campus Drives</a></li>
                                            <li><a class="dropdown-item" href="PlacementStudentSelection.aspx" id="navPlacementSelection">Student Selection</a></li>
                                            <li><a class="dropdown-item" href="PlacementLiaisonOfficers.aspx" id="navPlacementLiaison">Liaison Officers</a></li>
                                            <li><a class="dropdown-item" href="PlacmentProminentRecruiters.aspx" id="navPlacementRecruiters">Prominent Recruiters</a></li>
                                            <li><a class="dropdown-item" href="PlacementPolicy.aspx" id="navPlacementPolicy">Placement Policy</a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="Companies.aspx" id="navCompanies">Companies</a>
                                    </li>


                                    <li class="nav-item">
                                        <a class="nav-link" href="SuccessStories.aspx" id="navStories">Success Stories</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="Contact.aspx" id="navContact">Contact</a>
                                    </li>
                                </ul>

                                <!-- User Actions -->
                                <div class="navbar-actions d-flex align-items-center">
                                    <a href="#" class="icon-btn" title="Search" id="btnSearch"><i class="fa-solid fa-magnifying-glass"></i></a>
                                    <a href="#" class="icon-btn position-relative" title="Notifications" id="btnNotifications">
                                        <i class="fa-regular fa-bell"></i>
                                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-rku-red border border-light rounded-circle"></span>
                                    </a>
                                    <a href="Login.aspx" class="btn btn-login" id="btnLogin">Login</a>
                                    <a href="Register.aspx" class="btn btn-register" id="btnRegister">Register</a>
                                </div>
                            </div>
                        </div>
                    </nav>

                    <!-- Live Placement Updates Ticker -->
                    <div class="live-placement-ticker py-2 text-white border-bottom border-secondary-subtle" style="background: #0f172a !important; font-size: 0.84rem; position: relative; z-index: 1020;">
                        <div class="container-fluid px-lg-5 d-flex align-items-center">
                            <span class="badge bg-danger me-3 px-2.5 py-1.5 text-uppercase fw-bold d-flex align-items-center gap-1.5 shadow-sm" style="letter-spacing: 0.5px; font-size: 0.74rem; flex-shrink: 0;">
                                <span class="spinner-grow spinner-grow-sm text-light" style="width: 7px; height: 7px;" role="status"></span> Live Updates
                            </span>
                            <marquee behavior="scroll" direction="left" onmouseover="this.stop();" onmouseout="this.start();" scrollamount="6" class="text-white-50 fw-medium m-0 py-0.5">
                                <span class="text-white me-5"><i class="fa-solid fa-bullhorn text-warning me-1.5"></i> <strong>TCS Digital Drive 2026:</strong> Registrations open for Final Year B.Tech, BCA &amp; MCA students.</span>
                                <span class="text-white me-5"><i class="fa-solid fa-trophy text-danger me-1.5"></i> <strong>Placement Milestone:</strong> 54 students successfully placed at TatvaSoft campus drive!</span>
                                <span class="text-white me-5"><i class="fa-solid fa-star text-warning me-1.5"></i> <strong>Highest CTC:</strong> &#8377;20.0 LPA offered by Synoptek for Cloud Engineering profile.</span>
                                <span class="text-white me-5"><i class="fa-solid fa-building text-info me-1.5"></i> <strong>Upcoming Drive:</strong> Reliance Industries Limited (RIL) visiting campus on 15th October.</span>
                            </marquee>
                        </div>
                    </div>
            </asp:ContentPlaceHolder>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                <!-- ==========================================
         2. HERO SECTION
         ========================================== -->
                <section class="hero-section" id="heroSection">

                    <!-- Background Image Slides (only images change, not content) -->
                    <div class="hero-bg-slides" id="heroBgSlides">
                        <div class="hero-bg-slide active" style="background-image: url('assets/images/1000579953.jpg');"></div>
                        <div class="hero-bg-slide" style="background-image: url('assets/images/1000579960.jpg');"></div>
                        <div class="hero-bg-slide" style="background-image: url('assets/images/1000579964.jpg');"></div>
                        <div class="hero-bg-slide" style="background-image: url('assets/images/1000579965.jpg');"></div>
                    </div>

                    <!-- Dot Indicators -->
                    <div class="hero-slide-dots" id="heroSlideDots">
                        <span class="hero-dot active" data-slide="0"></span>
                        <span class="hero-dot" data-slide="1"></span>
                        <span class="hero-dot" data-slide="2"></span>
                        <span class="hero-dot" data-slide="3"></span>
                    </div>

                    <div class="container px-lg-5" style="position: relative; z-index: 2;">
                        <div class="row align-items-center">
                            <div class="col-lg-7">
                                <div class="hero-eyebrow"><i class="fa-solid fa-award text-warning me-1"></i> NAAC 'A' ACCREDITED · RK UNIVERSITY</div>
                                <h1 class="hero-title" id="heroTitle">Connecting Talent with <span class="text-rku-red">Opportunities</span></h1>
                                <p class="hero-subtitle" id="heroSubtitle">Empowering students with industry-ready careers, internships, and campus placements.</p>
                                <div class="d-flex flex-wrap gap-3">
                                    <button class="btn btn-rku" id="btnHeroExplore" onclick="window.location.href='PlacementCampusDrives.aspx'">Explore Placement Drives <i class="fa-solid fa-arrow-right ms-2"></i></button>
                                    <button class="hero-btn-outline" id="btnHeroReg" onclick="window.location.href='Register.aspx'">Student Registration <i class="fa-regular fa-user ms-2"></i></button>
                                </div>
                            </div>
                        </div>

                        <!-- Stats Strip -->
                        <div class="hero-stats-strip" id="heroStatsStrip">
                            <div class="row g-4 text-center text-lg-start">
                                <div class="col-lg-3 col-sm-6">
                                    <div class="hero-stat-item justify-content-center justify-content-lg-start">
                                        <div class="hero-stat-icon"><i class="fa-solid fa-user-graduate"></i></div>
                                        <div>
                                            <div class="hero-stat-num counter-value" data-target="5000" data-target-type="plus">0</div>
                                            <div class="hero-stat-label">Students Placed</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-sm-6">
                                    <div class="hero-stat-item justify-content-center justify-content-lg-start">
                                        <div class="hero-stat-icon"><i class="fa-solid fa-building"></i></div>
                                        <div>
                                            <div class="hero-stat-num counter-value" data-target="300" data-target-type="plus">0</div>
                                            <div class="hero-stat-label">Top Recruiters</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-sm-6">
                                    <div class="hero-stat-item justify-content-center justify-content-lg-start">
                                        <div class="hero-stat-icon"><i class="fa-solid fa-chart-line"></i></div>
                                        <div>
                                            <div class="hero-stat-num counter-value" data-target="85" data-target-type="percent">0</div>
                                            <div class="hero-stat-label">Placement Rate</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-sm-6">
                                    <div class="hero-stat-item justify-content-center justify-content-lg-start">
                                        <div class="hero-stat-icon"><i class="fa-solid fa-award"></i></div>
                                        <div>
                                            <div class="hero-stat-num counter-value" data-target="20" data-target-type="currency">0</div>
                                            <div class="hero-stat-label">Highest Package</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>


                <!-- ==========================================
         3. TOP RECRUITERS (TRUSTED BY LEADING COMPANIES)
         ========================================== -->
                <style>
                    #recruitersSection {
                        padding: 55px 0 45px 0 !important;
                        background: #ffffff !important;
                    }
                    .recruiters-header-wrapper {
                        display: flex;
                        flex-direction: row;
                        justify-content: space-between;
                        align-items: flex-end;
                        margin-bottom: 2rem;
                        padding: 0 0.5rem;
                        flex-wrap: wrap;
                        gap: 1.25rem;
                    }
                    .recruiters-eyebrow {
                        color: #ef3724 !important;
                        font-size: 0.82rem !important;
                        font-weight: 800 !important;
                        letter-spacing: 2px !important;
                        text-transform: uppercase !important;
                        display: block !important;
                        margin-bottom: 0.4rem !important;
                        font-family: var(--font-heading, 'Outfit', sans-serif) !important;
                    }
                    .recruiters-main-heading {
                        font-size: 2.25rem !important;
                        font-weight: 800 !important;
                        color: #0f2942 !important;
                        font-family: var(--font-heading, 'Outfit', sans-serif) !important;
                        margin-bottom: 0.5rem !important;
                        letter-spacing: -0.5px !important;
                    }
                    .recruiters-subtitle {
                        color: #64748b !important;
                        font-size: 0.98rem !important;
                        font-family: var(--font-body, 'Inter', sans-serif) !important;
                        margin-bottom: 0 !important;
                        max-width: 650px !important;
                        line-height: 1.55 !important;
                    }
                    .recruiters-view-link {
                        color: #ef3724 !important;
                        font-size: 0.95rem !important;
                        font-weight: 700 !important;
                        text-decoration: none !important;
                        display: inline-flex !important;
                        align-items: center !important;
                        gap: 0.4rem !important;
                        font-family: var(--font-heading, 'Outfit', sans-serif) !important;
                        transition: transform 0.2s ease, color 0.2s ease !important;
                    }
                    .recruiters-view-link:hover {
                        color: #c51e2b !important;
                        transform: translateX(4px) !important;
                    }
                    .recruiters-strip-container {
                        border: none !important;
                        border-top: none !important;
                        border-bottom: none !important;
                        background: transparent !important;
                        padding: 1.25rem 0 !important;
                        margin: 0.5rem 0 !important;
                        overflow: hidden !important;
                        position: relative !important;
                    }
                    .recruiters-strip-track {
                        display: flex !important;
                        width: max-content !important;
                        animation: recruitersScroll 26s linear infinite !important;
                    }
                    /* Do NOT stop scrolling on mouse hover */
                    .recruiters-strip-track:hover,
                    .recruiter-logo-clean-item:hover,
                    .recruiter-logo-card:hover {
                        animation-play-state: running !important;
                    }
                    @keyframes recruitersScroll {
                        0% { transform: translateX(0); }
                        100% { transform: translateX(-50%); }
                    }
                    .recruiter-logo-clean-item,
                    .recruiter-logo-card {
                        width: 210px !important;
                        min-width: 210px !important;
                        height: 72px !important;
                        background: transparent !important;
                        background-color: transparent !important;
                        border: none !important;
                        border-top: none !important;
                        border-bottom: none !important;
                        border-left: none !important;
                        border-right: 1px solid #eef2f6 !important;
                        border-radius: 0 !important;
                        box-shadow: none !important;
                        margin: 0 !important;
                        display: flex !important;
                        align-items: center !important;
                        justify-content: center !important;
                        padding: 0.6rem 2.25rem !important;
                        transition: transform 0.25s ease !important;
                    }
                    .recruiter-logo-clean-item:hover,
                    .recruiter-logo-card:hover {
                        background: transparent !important;
                        background-color: transparent !important;
                        border: none !important;
                        border-top: none !important;
                        border-bottom: none !important;
                        border-left: none !important;
                        border-right: 1px solid #eef2f6 !important;
                        border-radius: 0 !important;
                        box-shadow: none !important;
                        transform: scale(1.05) !important;
                    }
                    .recruiter-logo-clean-item svg,
                    .recruiter-logo-card svg,
                    .recruiter-logo-clean-item img,
                    .recruiter-logo-card img {
                        max-width: 140px !important;
                        max-height: 44px !important;
                        object-fit: contain !important;
                        border: none !important;
                    }
                </style>
                <section id="recruitersSection">
                    <div class="container px-3 px-md-4">
                        <div class="recruiters-header-wrapper">
                            <div>
                                <span class="recruiters-eyebrow">OUR TOP RECRUITERS</span>
                                <h2 class="recruiters-main-heading">Trusted by Leading Companies</h2>
                                <p class="recruiters-subtitle">We are proud to collaborate with industry leaders who value the talent and potential of our students.</p>
                            </div>
                            <div>
